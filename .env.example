# Opcional: copie para .env para sobrescrever os valores padrão (NÃO commite o .env).
# Sem .env o docker compose já funciona com os padrões abaixo.

# PostgreSQL
DB_NAME=oficina
DB_USERNAME=postgres
DB_PASSWORD=postgres
#DB_PORT=5433

# Aplicação
#APP_PORT=8080

# Apenas para rodar a aplicação fora do Docker (./mvnw spring-boot:run)
