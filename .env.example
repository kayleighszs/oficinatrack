# Copie este arquivo para .env e ajuste os valores (NÃO commite o .env):
#   cp .env.example .env

# --- PostgreSQL ---
DB_NAME=oficina
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Porta do banco exposta no seu computador (a 5432 costuma estar ocupada)
DB_PORT=5433

# --- Aplicação ---
APP_PORT=8080
# Mínimo de 32 caracteres. Troque em qualquer ambiente fora do seu computador.
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
JWT_EXPIRATION=1800000
PUBLIC_ACCESS_EXPIRATION_DAYS=7
OPENAPI_ENABLED=true

# --- Usuários criados na primeira execução (se vazios, nenhum usuário é criado) ---
GESTOR_USERNAME=gestor
GESTOR_PASSWORD=troque-esta-senha
ATENDENTE_USERNAME=atendente
ATENDENTE_PASSWORD=troque-esta-senha
MECANICO_USERNAME=mecanico
MECANICO_PASSWORD=troque-esta-senha

# --- Somente ao rodar a aplicação fora do Docker (./mvnw spring-boot:run) ---
DB_URL=jdbc:postgresql://localhost:5433/oficina
